# ============================================================
# Academix AI — Backend Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- Supabase Configuration ---
# Get these from: https://supabase.com → Your Project → Settings → API
# TODO: Paste your Supabase project URL here
SUPABASE_URL=https://your-project-id.supabase.co

# TODO: Paste your Supabase anon/public key here (safe for frontend too)
SUPABASE_KEY=your-supabase-anon-key

# TODO: Paste your Supabase service_role key here (KEEP SECRET — server-side only)
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# TODO: Paste your Supabase JWT secret here
# Get from: Supabase Dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- Groq API Configuration ---
# Get your API key from: https://console.groq.com/keys
# TODO: Paste your Groq API key here
GROQ_API_KEY=your-groq-api-key

# Groq model to use for generation (recommended: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# --- Embedding Model Configuration ---
# Local sentence-transformers model (downloaded automatically on first run)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- Application Settings ---
APP_NAME=Academix AI
APP_ENV=development
DEBUG=true

# Frontend URL for CORS (change in production)
FRONTEND_URL=http://localhost:5173

# Backend host/port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
